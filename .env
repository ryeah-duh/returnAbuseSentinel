# Copy this file to .env and fill in real values before running.
# Never commit the real .env file to git.

# --- Database ---
DATABASE_URL=postgresql://sentinel:sentinel_pw@postgres:5432/sentinel_db

# --- Redis (feature cache + dedup) ---
REDIS_URL=redis://redis:6379/0

# --- Kafka (async return-event queue) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RETURNS=returns.incoming
KAFKA_TOPIC_SCORED=returns.scored
KAFKA_CONSUMER_GROUP=sentinel-scorer

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=3ba4115e89b8cb137f8843c6b0199bbbdae6f25a745d0ed44b1db9f8d7380bbd
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600

# --- Model ---
MODEL_ARTIFACT_PATH=/app/artifacts/model_current.pkl
MODEL_MIN_GREEN_SHARE=0.55

# --- Cost model defaults (overridden per-merchant in DB) ---
DEFAULT_COST_MANUAL_REVIEW=150
DEFAULT_COST_INSPECTION=40
DEFAULT_COST_FRICTION=5
DEFAULT_FRACTION_LOST_ON_MISS=0.6

# --- Observability ---
PROMETHEUS_PORT=9100
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Drift monitoring ---
PSI_ALERT_THRESHOLD=0.2
PRECISION_DROP_ALERT_PCT=10

# --- App ---
APP_ENV=development
API_PORT=8000
